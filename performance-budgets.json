      ]
    },
    {
      "path": "/listings",
      "resourceSizes": [
        {
          "resourceType": "script",
          "budget": 320
        },
        {
          "resourceType": "image",
          "budget": 800
        },
        {
          "resourceType": "total",
          "budget": 700
        }
      ],
      "timings": [
        {
          "metric": "largest-contentful-paint",
          "budget": 2000
        }
      ]
    }
  ]
}
