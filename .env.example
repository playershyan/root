# vera.lk Environment Configuration
# Copy this file to .env.local for development or set these variables in your hosting platform

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Database Configuration (if using direct PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/autotrader_db"

# Cron Job Security
# Generate a secure random string for cron job authentication
# Example: openssl rand -base64 32
CRON_SECRET="your-secure-random-string-for-cron-authentication"

# Payment Integration
# Note: Stripe removed - using PayHere only for Sri Lankan market

# PayHere Configuration (Sri Lankan Payment Gateway)
PAYHERE_MERCHANT_ID="your_payhere_merchant_id"
PAYHERE_MERCHANT_SECRET="your_payhere_merchant_secret"
PAYHERE_CURRENCY="LKR"

# Email Configuration
# For sending promotion confirmations and notifications
EMAIL_FROM="noreply@vera.lk"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"

# AI Services
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key

# Text.lk SMS Gateway Configuration (Sri Lankan SMS Provider)
TEXTLK_API_KEY=your_textlk_api_bearer_token
TEXTLK_SENDER_ID=your_sender_id

# File Upload Configuration
# For image uploads (if using external storage)
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://vera.lk
NEXT_PUBLIC_APP_NAME="vera.lk"

# Feature Flags
ENABLE_PROMOTIONS="true"
ENABLE_ROTATION_SYSTEM="true"
ENABLE_PAYMENT_PROCESSING="true"

# Promotion Configuration (Optional - can be set in code)
FEATURED_SLOTS="2"
TOP_SPOT_SLOTS="2"
ROTATION_INTERVAL_HOURS="1"
BOOST_RESET_HOUR="0"

# Error Tracking (Optional - for production monitoring)
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here
SENTRY_ORG=your_sentry_org_slug
SENTRY_PROJECT=your_sentry_project_slug

# Security
JWT_SECRET="your-jwt-secret-for-auth"
CSRF_SECRET="your-csrf-secret-key"

# reCAPTCHA (set RECAPTCHA_ENABLED=true to enforce)
RECAPTCHA_ENABLED=false
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# If true, uploads must include a valid reCAPTCHA token
RECAPTCHA_UPLOAD_REQUIRED=false
# Client-side reCAPTCHA configuration
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key

# Redis/Upstash Configuration (for distributed rate limiting)
UPSTASH_REDIS_REST_URL=your_upstash_redis_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# AI Abuse Protection
AI_RATE_LIMIT_PER_MINUTE=10
AI_DAILY_LIMIT=100

# Distributed Rate Limiting (Upstash Redis)
USE_UPSTASH=false
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Quarantine settings (temporary IP block after repeated 429s)
QUARANTINE_ENABLED=false
QUARANTINE_THRESHOLD=5
QUARANTINE_WINDOW_SECONDS=120
QUARANTINE_BAN_SECONDS=600

# Google Authentication
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Monitoring URLs (for health checks)
HEALTH_CHECK_TOKEN="your-health-check-token"
